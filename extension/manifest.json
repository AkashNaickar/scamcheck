{
  "manifest_version": 3,
  "name": "ScamCheck",
  "version": "0.1.0",
  "description": "Check a suspicious message for scam warning signs using ScamCheck.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ScamCheck" },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
